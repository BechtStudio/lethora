     #[test]
+    fn checkout_across_one_long_insert_span() {
+        // One contiguous insert span is stored as many MAX_FRAGMENT_LEN fragments in
+        // id_to_cursor, so retreating/forwarding it yields one rope update per fragment.
+        const N: u32 = 64 * 1024;
+        let mut t = Tracker::new();
+        t.insert(IdFull::new(1, 0, 0), 0, RichtextChunk::new_text(0..18));
+        t.insert(IdFull::new(1, 18, 18), 18, RichtextChunk::new_text(18..18 + N));
+        let start = Instant::now();
+        t.checkout(&vv!(1 => 18));
+        t.check();
+        assert_eq!(t.len(), 18);
+        t.checkout(&vv!(1 => 18 + N as Counter));
+        t.check();
+        assert_eq!(t.len(), 18 + N as usize);
+        let diff_items = t.diff(&vv!(1 => 18 + N as Counter), &vv!(1 => 18)).count();
+        assert!(diff_items > 0);
+        println!("checkout_across_one_long_insert_span: {:?}", start.elapsed());
+    }
+
+    #[test]
+    fn update_insert_by_split_with_repeated_leaf() {
+        // When the pieces of a split leaf merge back, the same leaf index is reported
+        // once per piece. Each repeat must not rescan the whole span.
+        let mut t = Tracker::new();
+        t.insert(IdFull::new(1, 0, 0), 0, RichtextChunk::new_text(0..64 * 1024));
+        let leaf = t.id_to_cursor.get_insert(ID::new(1, 0)).unwrap();
+        t.update_insert_by_split(&vec![leaf; 256]);
+        t.check();
+        assert_eq!(t.id_to_cursor.get_insert(ID::new(1, 64 * 1024 - 1)), Some(leaf));
+    }
