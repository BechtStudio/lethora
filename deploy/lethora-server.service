# lethora-server as a systemd service (see docs/dev/server.md).
#
#   install -m 755 target/release/lethora-server /usr/local/bin/
#   install -D -m 644 deploy/lethora-server.example.toml /etc/lethora/lethora-server.toml
#   (edit public_url, and trusted_proxies for the reverse proxy)
#   install -m 644 deploy/lethora-server.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now lethora-server
#
# Data: /var/lib/lethora (StateDirectory). The default data_dir,
# "lethora-data", is relative to it: /var/lib/lethora/lethora-data. An
# absolute data_dir elsewhere also needs ReadWritePaths=.
# Logs: journalctl -u lethora-server.

[Unit]
Description=Lethora sync server
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/lethora-server --config /etc/lethora/lethora-server.toml
Environment=RUST_LOG=info
WorkingDirectory=/var/lib/lethora
Restart=on-failure
RestartSec=5s
# Many open WebSocket connections.
LimitNOFILE=65536

# A user made up at start, owning only /var/lib/lethora.
DynamicUser=yes
StateDirectory=lethora
StateDirectoryMode=0700
ConfigurationDirectory=lethora
UMask=0077

# Hardening: no privileges, read-only system, nothing but the network.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
